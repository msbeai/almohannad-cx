---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
---

<Base lang="ar" title="عنّي — المهند السبيعي" altPath="/en/about" current="/about">
  <div class="wrap">
    <section class="rail-scroller" data-rail tabindex="0" role="region" aria-roledescription="بطاقات قابلة للتمرير أفقيًّا" aria-label="ما وراء السيرة" data-pagefind-body>
      <div class="rail-bar" aria-hidden="true"></div>
      <ul class="rail-track" role="list">
      <li class="rail-card rail-card--cover" role="listitem"><span class="rail-pin" aria-hidden="true"></span><article class="fcard fcard--cover">
        <img class="cover-avatar" src="/images/avatar.jpg" alt="المهند السبيعي" width="84" height="84" />
        <h1>ما وراء السيرة</h1>
        <p>بطاقاتٌ قصيرة عن الإنسان خلف العمل — المهند السبيعي.</p>
      </article></li>

      <li class="rail-card" role="listitem"><span class="rail-pin" aria-hidden="true"></span><article class="fcard">
        <span class="fcard-num" aria-hidden="true">١</span>
        <h2>مُسمّى على اسم سيف</h2>
        <div class="fc-term"><span class="term">المُهنَّد</span><span class="pos">[اسم]</span></div>
        <p>سيفٌ عالي الجودة من الفولاذ الهندي، اشتُهر بقوّته وحدّته وإتقان صناعته — رمزٌ للقوّة والدقّة في الثقافة العربية.</p>
        <p class="fcard-note">نادِني «مهنّد» وأسقِط «الـ»، فهو أبسط. وإن آثرتَ التقليد، فـ«أبو رند» تفي بالغرض.</p>
      </article></li>

      <li class="rail-card" role="listitem"><span class="rail-pin" aria-hidden="true"></span><article class="fcard">
        <span class="fcard-num" aria-hidden="true">٢</span>
        <h2>لا صخب، بل رسوخ</h2>
        <p class="fcard-lead">أُقدّر النظام والمسؤولية والقوّة الهادئة.</p>
        <ul>
          <li>أُفكّر مليًّا قبل أن أتكلّم — متروٍّ لا سلبيّ.</li>
          <li>أقود بالأصالة والهدوء والتعاطف، لا بعلوّ الصوت.</li>
        </ul>
        <p class="fcard-note">باختصار: حاضرٌ بهدوء، وموثوقٌ على الدوام.</p>
      </article></li>

      <li class="rail-card" role="listitem"><span class="rail-pin" aria-hidden="true"></span><article class="fcard">
        <span class="fcard-num" aria-hidden="true">٣</span>
        <h2>قِيَمي، بوصلتي</h2>
        <ol>
          <li><strong>المسؤولية:</strong> يُعتمد عليّ.</li>
          <li><strong>التعاطف:</strong> أُنصت لأفهم.</li>
          <li><strong>النزاهة:</strong> أفعل الصواب بصدق.</li>
          <li><strong>الانضباط الذاتي:</strong> نظامٌ ونموٌّ مقصود.</li>
          <li><strong>الحكمة:</strong> قراراتٌ متأنّية.</li>
          <li><strong>الاستقلالية:</strong> رأيٌ متّزنٌ صادق.</li>
          <li><strong>المعنى:</strong> عملٌ يستحقّ الجهد.</li>
        </ol>
      </article></li>

      <li class="rail-card" role="listitem"><span class="rail-pin" aria-hidden="true"></span><article class="fcard">
        <span class="fcard-num" aria-hidden="true">٤</span>
        <h2>حياةٌ خارج العمل</h2>
        <p>منظَّمٌ ومركِّزٌ في العمل، وفي البيت أقود بقلبي.</p>
        <p><strong>عائلتي هي سببي وفرحي وسندي الأكبر.</strong> العمل مهمّ، لكنّ الحبّ هو كلّ شيء. 🤍</p>
        <p>أبٌ فخورٌ لثلاثة: رند (٢٠١٠)، وورد (٢٠١٢)، وزيد (٢٠١٨).</p>
      </article></li>

      <li class="rail-card" role="listitem"><span class="rail-pin" aria-hidden="true"></span><article class="fcard">
        <span class="fcard-num" aria-hidden="true">٥</span>
        <h2>وقودُ وقتي الحر</h2>
        <p class="fcard-lead">ما نحبّه في أوقات فراغنا يقول عنّا الكثير. وهذه أشيائي:</p>
        <ul class="plain">
          <li>📚 القراءة — حيواتٌ لا تُحصى.</li>
          <li>📝 الكتابة — طريقي للوضوح.</li>
          <li>🍳 الطبخ — استجمامٌ واهتمام.</li>
          <li>🏓 كرة الطاولة — يدٌ سريعة.</li>
          <li>🎾 البادل — مبتدئٌ مستمتع.</li>
          <li>☕ القهوة — طقسٌ أحبّه.</li>
        </ul>
      </article></li>

      <li class="rail-card" role="listitem"><span class="rail-pin" aria-hidden="true"></span><article class="fcard">
        <span class="fcard-num" aria-hidden="true">٦</span>
        <h2>رحلة، لا وجهة</h2>
        <p class="fcard-lead">على مدى ١٨ عامًا عملتُ في ٩ شركات، صقلت كلٌّ منها نموّي بطريقتها:</p>
        <p>فيدكس، سينوفيت، إبسوس، علم، مصرف الراجحي، الصادرات السعودية، شورمر، Tweeq، رواء.</p>
        <p class="fcard-note">💡 أبقى ما دمتُ أُضيف قيمةً أو أكتسبها؛ وحين يتعذّر الأمران، أمضي.</p>
      </article></li>

      <li class="rail-card" role="listitem"><span class="rail-pin" aria-hidden="true"></span><article class="fcard">
        <span class="fcard-num" aria-hidden="true">٧</span>
        <h2>لأرتقي، لا لأُقيّم</h2>
        <p class="fcard-lead">أحضر لأرتقي لا لأُقيّم — وهكذا أعمل:</p>
        <ol>
          <li>أُقيّم النضج وأرسم الطريق.</li>
          <li>أُنصت للفرص، لا للنقد.</li>
          <li>أقيس ما يهمّ فعلًا.</li>
          <li>أُصمّم رحلاتٍ تفي بالوعد.</li>
          <li>أبني ثقافةَ تميّزٍ دائمة.</li>
        </ol>
        <p class="fcard-note"><strong>وعدي:</strong> نرفع السقف معًا.</p>
      </article></li>

      <li class="rail-card rail-card--cover" role="listitem"><span class="rail-pin" aria-hidden="true"></span><article class="fcard fcard--cover">
        <p>للتواصل، تجدني على <a href={SITE.linkedin} target="_blank" rel="noopener">لينكدإن</a> أو راسلني على <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      </article></li>
    </ul>
      <p class="rail-hint" aria-hidden="true">اسحب البطاقات ←</p>
    </section>
    <div style="height: 2rem"></div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { Draggable } from "gsap/Draggable";
    import { InertiaPlugin } from "gsap/InertiaPlugin";

    let drag = null, ro = null, introTriggers = [], onKey = null, onFocus = null, bound = false;
    const tickHandle = { fn: null };

    function gateStatic(scroller, track) {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return "reduced-motion";
      if (matchMedia("(max-width: 760px)").matches) return "narrow";
      if (matchMedia("(pointer: coarse)").matches && innerWidth < 1100) return "coarse";
      if (Math.max(0, track.scrollWidth - scroller.clientWidth) <= 0) return "no-overflow";
      return false;
    }

    function init() {
      if (drag) return;
      const scroller = document.querySelector(".rail-scroller[data-rail]");
      const track = scroller && scroller.querySelector(".rail-track");
      if (!scroller || !track) return;
      if (gateStatic(scroller, track)) return;

      gsap.registerPlugin(Draggable, InertiaPlugin);
      InertiaPlugin.track(track, "x");
      scroller.classList.add("is-enhanced");

      const cards = gsap.utils.toArray(".rail-card", track);
      const rtl = getComputedStyle(track).direction === "rtl";
      const dirSign = rtl ? -1 : 1;

      const meta = cards.map((c) => {
        const fcard = c.querySelector(".fcard");
        const pin = c.querySelector(".rail-pin");
        const h = c.offsetHeight;
        return { c, fcard, pin, offset: c.offsetLeft, w: c.offsetWidth, heightFactor: gsap.utils.clamp(0.45, 1, 560 / h) };
      });

      let viewportW = scroller.clientWidth;
      const computeBounds = () => {
        const maxScroll = Math.max(0, track.scrollWidth - viewportW);
        return rtl ? { minX: 0, maxX: maxScroll } : { minX: -maxScroll, maxX: 0 };
      };
      let bounds = computeBounds();

      let lastX = null, lastT = 0, velocity = 0;
      const entered = new Set();

      function swingCard(m, direction, e) {
        const peak = (1 + e * 8) * m.heightFactor;
        const outDur = 0.25 + e * 0.15;
        const backDur = 1 + e * 5;
        const backEase = `elastic.out(1, ${0.4 - e * 0.3})`;
        gsap.killTweensOf(m.fcard, "rotation");
        gsap.killTweensOf(m.pin, "rotation");
        gsap.timeline()
          .to(m.fcard, { rotation: -peak * direction, duration: outDur, ease: "power2.out" })
          .to(m.fcard, { rotation: 0, duration: backDur, ease: backEase });
        gsap.timeline()
          .to(m.pin, { rotation: peak * direction, duration: outDur, ease: "power2.out" })
          .to(m.pin, { rotation: 0, duration: backDur, ease: "elastic.out(1, 0.3)" });
      }

      // Dave-style ticker: swing a card ONCE as it enters the viewport while the rail moves
      function tick() {
        const x = Number(gsap.getProperty(track, "x")) || 0;
        const now = performance.now();
        if (lastX !== null && now > lastT) velocity = ((x - lastX) / (now - lastT)) * 1000;
        lastX = x; lastT = now;
        if (Math.abs(velocity) < 40) return;             // idle: do nothing (intro plays undisturbed)
        const e = Math.min(Math.abs(velocity) / 3000, 1);
        const direction = (velocity < 0 ? 1 : -1) * dirSign;
        for (const m of meta) {
          const left = m.offset + x;
          const visible = left < viewportW && left + m.w > 0;
          if (visible && !entered.has(m)) { entered.add(m); swingCard(m, direction, e); }
          else if (!visible && entered.has(m)) entered.delete(m);
        }
      }
      tickHandle.fn = tick;
      gsap.ticker.add(tick);

      drag = Draggable.create(track, {
        type: "x",
        inertia: true,
        edgeResistance: 1,
        overshootTolerance: 0,
        bounds,
        dragClickables: false,
        minimumMovement: 6,
        allowNativeTouchScrolling: true,
        zIndexBoost: false,
        onPress() { this._sx = this.pointerX; this._sy = this.pointerY; this._decided = false; entered.clear(); },
        onDrag(e) {
          if (!this._decided) {
            this._decided = true;
            if (e.pointerType === "touch" && Math.abs(this.pointerY - this._sy) > Math.abs(this.pointerX - this._sx)) { this.endDrag(e); return; }
          }
        },
      })[0];

      // flash-free intro: cards stay in place and elastically settle-swing into upright
      meta.forEach((m, i) => {
        gsap.set(m.fcard, { rotation: i % 2 ? -6 : 6 });
        gsap.set(m.pin, { rotation: i % 2 ? 6 : -6 });
        introTriggers.push(
          gsap.timeline({ delay: 0.15 + i * 0.08 })
            .to(m.fcard, { rotation: 0, duration: 2.4, ease: "elastic.out(1, 0.3)" }, 0)
            .to(m.pin, { rotation: 0, duration: 2.4, ease: "elastic.out(1, 0.35)" }, 0)
        );
      });

      const stepBase = () => Math.max(160, scroller.clientWidth * 0.35);
      const liveX = () => Number(gsap.getProperty(track, "x")) || 0;
      const glide = (target, dur) => gsap.to(track, { x: target, duration: dur, ease: "power3.out", overwrite: "auto", onComplete: () => drag && drag.update() });
      onKey = (ev) => {
        let physical = 0;
        if (ev.key === "ArrowRight") physical = 1;
        else if (ev.key === "ArrowLeft") physical = -1;
        else if (ev.key === "Home") { ev.preventDefault(); glide(rtl ? bounds.minX : bounds.maxX, 0.5); return; }
        else if (ev.key === "End") { ev.preventDefault(); glide(rtl ? bounds.maxX : bounds.minX, 0.5); return; }
        else return;
        const delta = (rtl ? physical : -physical) * stepBase();
        const target = gsap.utils.clamp(bounds.minX, bounds.maxX, liveX() + delta);
        if (target === liveX()) return;
        ev.preventDefault();
        glide(target, 0.6);
      };
      scroller.addEventListener("keydown", onKey);

      onFocus = (e) => {
        const item = e.target.closest(".rail-card");
        if (!item) return;
        const want = rtl ? (Math.max(0, track.scrollWidth - viewportW) - item.offsetLeft) : -item.offsetLeft;
        glide(gsap.utils.clamp(bounds.minX, bounds.maxX, want), 0.4);
      };
      scroller.addEventListener("focusin", onFocus);

      let rt;
      ro = new ResizeObserver(() => {
        clearTimeout(rt);
        rt = setTimeout(() => {
          requestAnimationFrame(() => {
            viewportW = scroller.clientWidth;
            meta.forEach((m) => { m.offset = m.c.offsetLeft; m.w = m.c.offsetWidth; });
            bounds = computeBounds();
            drag.applyBounds(bounds);
            if (gateStatic(scroller, track)) teardown();
          });
        }, 250);
      });
      ro.observe(scroller);
    }

    function teardown() {
      if (tickHandle.fn) { gsap.ticker.remove(tickHandle.fn); tickHandle.fn = null; }
      if (drag) { drag.kill(); drag = null; }
      introTriggers.forEach((t) => t.kill()); introTriggers = [];
      if (ro) { ro.disconnect(); ro = null; }
      const scroller = document.querySelector(".rail-scroller[data-rail]");
      if (scroller) {
        if (onKey) scroller.removeEventListener("keydown", onKey);
        if (onFocus) scroller.removeEventListener("focusin", onFocus);
        scroller.classList.remove("is-enhanced");
      }
      onKey = null; onFocus = null;
      gsap.set(".rail-track, .rail-card, .rail-card .fcard, .rail-pin", { clearProps: "transform,will-change" });
    }

    if (!bound) {
      bound = true;
      document.addEventListener("astro:page-load", init);
      document.addEventListener("astro:before-swap", teardown);
      window.addEventListener("pagehide", teardown);
      matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", () => { teardown(); init(); });
      matchMedia("(max-width: 760px)").addEventListener("change", () => { teardown(); init(); });
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
      else init();
    }
  </script>

  <style is:global>
    /* About = single-viewport experience: no vertical page scroll (like the reference).
       Falls back to normal scrolling on phones and short screens. */
    @media (min-width: 761px) and (min-height: 800px) {
      body { height: 100dvh; overflow: hidden; display: flex; flex-direction: column; }
      body > main { flex: 1; display: flex; flex-direction: column; justify-content: center; min-height: 0; }
      .rail-scroller { padding-block: 4.6rem 2.4rem; }
      .site-footer { margin-top: 0; padding-block: 1.1rem; }
    }
  </style>
</Base>
